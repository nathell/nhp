           hiccup/hiccup                       {:mvn/version "2.0.0-RC1"}
           io.forward/yaml                     {:mvn/version "1.0.11" :exclusions [org.flatland/ordered]}
           io.github.nextjournal/markdown      {:mvn/version "0.7.225"}
           org.clojure/data.xml                {:mvn/version "0.2.0-alpha8"}
           org.flatland/ordered                {:mvn/version "1.15.11"}
           org.graalvm.polyglot/polyglot       {:mvn/version "25.0.3"}
           org.graalvm.js/js-language          {:mvn/version "25.0.3"}
           org.graalvm.js/js-scriptengine      {:mvn/version "25.0.3"}
           org.graalvm.truffle/truffle-runtime {:mvn/version "25.0.3"}
           reaver/reaver                       {:mvn/version "0.1.3"}}
